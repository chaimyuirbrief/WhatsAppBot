# dependencies
node_modules/

# runtime data — contains the live WhatsApp session, encrypted config,
# the member/message index, and rotated logs. NEVER commit.
data/

# secrets — MASTER_KEY decrypts the config; must never leave the server
.env
.env.*

# backups — a .wabak is a working copy of the WhatsApp account plus the key to
# every stored secret. Encrypted, but never commit one.
*.wabak
data.pre-restore-*/

# network filter CA certs (if any are dropped in)
certs/*.crt
certs/*.pem

# logs / scratch
*.log
*.tmp

# generated from whatsapp-bot.service.template by install.sh
whatsapp-bot.service

# Windows "downloaded from the internet" markers
*:Zone.Identifier
